{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plot",
  "version": "0.3.0",
  "identifier": "com.oelburk.plot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Plot",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1REIyQ0I1RDI5N0YwOTQKUldTVThKZlN0U3piTmVaSGlpdElJYXpsTFpjLzdmOEpiL3lxRy80UVozK3FVcWdVb1NwaHg2b0kK",
      "endpoints": ["https://github.com/oelburk/plot/releases/latest/download/latest.json"]
    }
  }
}
